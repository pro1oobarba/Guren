# Скопируй этот файл в .env и впиши свои ключи (без кавычек).
# .env никогда не публикуй и не коммить в git.

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cloudflare Workers AI:
#  - CLOUDFLARE_ACCOUNT_ID: dashboard.cloudflare.com -> Account ID справа снизу на любой странице
#  - CLOUDFLARE_API_TOKEN: My Profile -> API Tokens -> Create Token -> с правом "Workers AI: Read"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Необязательно: попадают в заголовки запросов к OpenRouter (для их статистики)
APP_SITE_URL=http://localhost
APP_NAME=AI-Kernel

# GitHub Models закрыт GitHub 30.07.2026 — переменная больше не нужна и не используется.
# GITHUB_TOKEN=

# Cerebras — https://cloud.cerebras.ai/platform/apikeys
CEREBRAS_API_KEY=

# SambaNova — https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# DeepInfra (платный по токену, но очень дёшево) — https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# Hyperbolic — https://app.hyperbolic.xyz/settings
HYPERBOLIC_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hugging Face — https://huggingface.co/settings/tokens
HF_TOKEN=

# Провайдеры, которые надо выключить без правки кода (например баланс $0).
# Пример: PROVIDERS_DISABLED=deepinfra,hyperbolic
PROVIDERS_DISABLED=
