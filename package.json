{
  "name": "ai-kernel",
  "version": "0.1.0",
  "description": "Универсальное AI-ядро: tier-роутинг, авто-fallback и авто-восстановление между несколькими бесплатными AI-провайдерами",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "kernel.js",
  "exports": {
    ".": "./kernel.js"
  },
  "scripts": {
    "start": "node --env-file=.env index.js",
    "serve": "node --env-file=.env server.js",
    "health": "node --env-file=.env -e \"import('./kernel.js').then(({ AI }) => AI.init())\"",
    "doctor": "node scripts/checkEnv.js",
    "test": "node --test",
    "hooks:install": "node scripts/installHooks.js",
    "backup": "node scripts/backup.js"
  }
}
